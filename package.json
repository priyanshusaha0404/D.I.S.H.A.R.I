{
  "name": "dishari-trip",
  "version": "1.0.0",
  "private": true,
  "description": "D.I.S.H.A.R.I — Sundarbans smart trip: WebGIS, trip planner and AI assistant (static site + small Node server for the AI)",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build && node scripts/build-sw.mjs",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "export-data": "python tools/export_data.py --clean"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/audiowide": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.1.0",
    "docx": "9.0.3",
    "echarts": "5.5.1",
    "fflate": "^0.8.2",
    "lucide-react": "0.453.0",
    "maplibre-gl": "4.7.1",
    "next": "14.2.35",
    "pdfmake": "0.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "write-excel-file": "1.4.30"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.14",
    "@types/node": "20.16.11",
    "@types/pdfmake": "0.2.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3"
  }
