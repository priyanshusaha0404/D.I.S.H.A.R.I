# Copy this file to .env and put your key in it. The key stays on the server — users never see or type it.
# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# More keys (optional) — used one after another; when one reaches its limit the next takes over:
# GEMINI_API_KEYS=key1,key2,key3,key4,key5,key6,key7,key8,key9
GEMINI_MODEL=gemini-flash-latest

# …or any OpenAI-compatible service instead (OpenAI, OpenRouter, Groq, a local Ollama):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE=https://api.openai.com/v1

PORT=3100
